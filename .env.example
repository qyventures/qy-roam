STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Random 32+ character secret used to bind QY Roam checkout sessions to this app.
ORDER_INTEGRITY_SECRET=
# Use a single-line random value of 32+ characters. Temporary 32+ character
# prior key during ORDER_INTEGRITY_SECRET rotation; remove it after the
# in-flight Checkout/webhook recovery window.
# Remove it after all pre-rotation Checkout Sessions and Stripe webhook retries have cleared.
ORDER_INTEGRITY_SECRET_PREVIOUS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://qyroam.com
COURIER_FEE_SGD=0
MIN_DELIVERY_LEAD_DAYS=2
POCKET_WIFI_INVENTORY=10
# Hosted project API origin only, for example https://project-ref.supabase.co.
# Paths, query strings, credentials, custom ports, and custom domains fail closed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
ADMIN_USER=
# Use a 16+ character printable-ASCII password. This keeps browser and
# command-line Basic Auth encoding consistent with the release readiness gate.
ADMIN_PASSWORD=
HEALTH_CHECK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional HTTPS SMTP relay. Set both values or neither; direct SMTP is used
# when both are unset. The relay secret should be a random value (24+ chars).
SMTP_RELAY_URL=
SMTP_RELAY_SECRET=
# Optional relay responses must be JSON and confirm the submitted identity:
# {"delivered":true,"message_id":"<the submitted message_id>"}
# Required: explicit mailbox or distribution list for paid-order fulfilment.
ORDER_FULFILMENT_EMAIL=
