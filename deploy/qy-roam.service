[Unit]
Description=QY Roam Next.js production service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/qy-roam
EnvironmentFile=/root/.config/qyroam/.env
Environment=NODE_ENV=production
Environment=PORT=3100
# The application trusts X-Real-IP only after Nginx replaces it with the
# socket peer. Keep the Next.js standalone server private to that proxy: its
# generated server otherwise defaults to 0.0.0.0, which would let callers
# bypass the TLS/security-header ingress and supply spoofed forwarding headers.
Environment=HOSTNAME=127.0.0.1
# Let systemd supervise the actual HTTP server, not an npm wrapper process.
# This ensures SIGTERM reaches Next.js immediately so its graceful shutdown
# can drain an in-flight paid-order webhook before the replacement starts.
ExecStart=/usr/bin/node /root/qy-roam/.next/standalone/server.js
Restart=always
RestartSec=5
# Nginx allows a bounded paid-order webhook up to 120 seconds for Stripe
# retrieval, persistence, and independent fulfilment/analytics delivery.
# Give the standalone server enough graceful-stop time to finish that work
# during a release instead of killing the worker at 20 seconds and making
# Stripe retry an otherwise healthy event. The application still has bounded
# request/dependency deadlines, while systemd retains a finite hard stop.
TimeoutStopSec=150

# Basic hardening while retaining access to app files and outbound network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
