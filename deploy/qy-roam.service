[Unit]
Description=QY Roam Next.js production service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/qy-roam
EnvironmentFile=/root/.config/qyroam/.env
Environment=NODE_ENV=production
Environment=PORT=3100
# The application trusts X-Real-IP only after Nginx replaces it with the
# socket peer. Keep the Next.js standalone server private to that proxy: its
# generated server otherwise defaults to 0.0.0.0, which would let callers
# bypass the TLS/security-header ingress and supply spoofed forwarding headers.
Environment=HOSTNAME=127.0.0.1
# Let systemd supervise the actual HTTP server, not an npm wrapper process.
# This ensures SIGTERM reaches Next.js immediately so its graceful shutdown
# can drain an in-flight paid-order webhook before the replacement starts.
ExecStart=/usr/bin/node /root/qy-roam/.next/standalone/server.js
Restart=always
RestartSec=5
# Nginx allows a bounded paid-order webhook up to 120 seconds for Stripe
# retrieval, persistence, and independent fulfilment/analytics delivery.
# Give the standalone server enough graceful-stop time to finish that work
# during a release instead of killing the worker at 20 seconds and making
# Stripe retry an otherwise healthy event. The application still has bounded
# request/dependency deadlines, while systemd retains a finite hard stop.
TimeoutStopSec=150

# Treat the reviewed application artifact and its environment as immutable at
# runtime. Next.js may use .next/cache for bounded framework caches, so retain
# that one explicit write path instead of leaving the whole root-owned checkout
# writable to a compromised request handler.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/qy-roam/.next/cache
# The storefront needs ordinary network sockets for Stripe, Supabase, SMTP and
# Meta, but it never needs device, kernel, namespace, control-group or setuid
# administration. An empty bounding set is required here: NoNewPrivileges only
# prevents gaining new privileges and does not remove the capabilities already
# held by this root-owned process. Limit socket creation to the Unix and IP
# families used by DNS and the reviewed local/external HTTP/SMTP connections.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
